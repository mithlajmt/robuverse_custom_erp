generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
  CAPITAL
  TRANSFER
}

enum TransactionStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK
  UPI
  CHEQUE
  OTHER
}

enum DebtDirection {
  PAYABLE
  RECEIVABLE
}

enum TransactionSource {
  EXCEL_IMPORT
  MANUAL
  SALARY_MODULE
  DEBT_MODULE
  SYSTEM
}

enum CashFlowDirection {
  INFLOW
  OUTFLOW
  NEUTRAL
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum DebtStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

model Profile {
  id           String        @id
  email        String        @unique
  fullName     String?
  role         String        @default("member")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdItems Transaction[] @relation("TransactionCreatedBy")
  updatedItems Transaction[] @relation("TransactionUpdatedBy")
}

model Category {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  type             TransactionType?
  parentCategoryId String?
  parentCategory   Category?         @relation("CategoryTree", fields: [parentCategoryId], references: [id])
  childCategories  Category[]        @relation("CategoryTree")
  transactions     Transaction[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([type])
}

model Employee {
  id           String         @id @default(cuid())
  name         String
  phone        String?
  role         String?
  salaryType   String?
  status       EmployeeStatus @default(ACTIVE)
  transactions Transaction[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([name])
}

model Project {
  id           String        @id @default(cuid())
  code         String?       @unique
  name         String
  description  String?
  status       ProjectStatus @default(ACTIVE)
  startDate    DateTime?
  endDate      DateTime?
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
}

model Debt {
  id             String        @id @default(cuid())
  personName     String
  direction      DebtDirection
  amount         Decimal       @db.Decimal(14, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(14, 2)
  remainingAmount Decimal      @default(0) @db.Decimal(14, 2)
  status         DebtStatus    @default(OPEN)
  notes          String?
  transactions   Transaction[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([personName])
  @@index([direction, status])
}

model Transaction {
  id                String            @id @default(cuid())
  type              TransactionType
  status            TransactionStatus @default(COMPLETED)
  cashFlowDirection CashFlowDirection @default(NEUTRAL)
  categoryId        String
  category          Category          @relation(fields: [categoryId], references: [id])
  amount            Decimal           @db.Decimal(14, 2)
  description       String
  projectId         String?
  project           Project?          @relation(fields: [projectId], references: [id])
  employeeId        String?
  employee          Employee?         @relation(fields: [employeeId], references: [id])
  debtId            String?
  debt              Debt?             @relation(fields: [debtId], references: [id])
  transactionDate   DateTime
  paymentMethod     PaymentMethod     @default(OTHER)
  referenceNumber   String?
  attachmentUrl     String?
  notes             String?
  source            TransactionSource @default(MANUAL)
  isSystemGenerated Boolean           @default(false)
  createdById       String?
  createdBy         Profile?          @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  updatedById       String?
  updatedBy         Profile?          @relation("TransactionUpdatedBy", fields: [updatedById], references: [id])
  isDeleted         Boolean           @default(false)
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([type, transactionDate])
  @@index([status])
  @@index([categoryId])
  @@index([projectId])
  @@index([employeeId])
  @@index([debtId])
  @@index([isDeleted])
  @@index([source])
}
