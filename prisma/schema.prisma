generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
  CAPITAL
  TRANSFER
}

enum TransactionStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK
  UPI
  CHEQUE
  OTHER
}

enum DebtDirection {
  PAYABLE
  RECEIVABLE
}

enum TransactionSource {
  EXCEL_IMPORT
  MANUAL
  SALARY_MODULE
  DEBT_MODULE
  SYSTEM
}

enum CashFlowDirection {
  INFLOW
  OUTFLOW
  NEUTRAL
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum DebtStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

model Profile {
  id               String         @id
  email            String         @unique
  fullName         String?
  role             String         @default("member")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdItems     Transaction[]  @relation("TransactionCreatedBy")
  updatedItems     Transaction[]  @relation("TransactionUpdatedBy")
  assignedLeads    Lead[]         @relation("LeadAssignedTo")
  createdLeads     Lead[]         @relation("LeadCreatedBy")
  createdFollowUps LeadFollowUp[]
}

enum LeadStatus {
  NEW_ENQUIRY
  CONTACTED
  REQUIREMENT_GATHERED
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  HOT
  WARM
  COLD
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  PHONE
  EMAIL
  EXHIBITION
  REFERRAL
  OTHER
}

enum FollowUpType {
  CALL
  MEETING
  EMAIL
  WHATSAPP
  NOTE
}

model Lead {
  id               String         @id @default(cuid())
  leadNumber       String         @unique
  name             String?        @default("Inquiry")
  company          String?
  email            String?
  phone            String?
  source           LeadSource     @default(WEBSITE)
  status           LeadStatus     @default(NEW_ENQUIRY)
  priority         LeadPriority   @default(WARM)
  estimatedValue   Decimal        @default(0) @db.Decimal(14, 2)
  enquiryDate      DateTime       @default(now())
  nextFollowUpDate DateTime?
  notes            String?
  category         String?        @default("GENERAL")
  venueType        String?
  eventDate        DateTime?
  eventLocation    String?
  assignedToId     String?
  assignedTo       Profile?       @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  followUps        LeadFollowUp[]
  linkedDocs       String[]       @default([])
  createdById      String?
  createdBy        Profile?       @relation("LeadCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([priority])
  @@index([leadNumber])
  @@index([enquiryDate])
}

model LeadFollowUp {
  id             String       @id @default(cuid())
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  date           DateTime     @default(now())
  type           FollowUpType @default(NOTE)
  summary        String
  nextActionDate DateTime?
  createdById    String?
  createdBy      Profile?     @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([leadId])
  @@index([date])
}

model Category {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  type             TransactionType?
  parentCategoryId String?
  parentCategory   Category?         @relation("CategoryTree", fields: [parentCategoryId], references: [id])
  childCategories  Category[]        @relation("CategoryTree")
  transactions     Transaction[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([type])
}

model Employee {
  id           String         @id @default(cuid())
  name         String
  phone        String?
  role         String?
  salaryType   String?
  status       EmployeeStatus @default(ACTIVE)
  transactions Transaction[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([name])
}

model Project {
  id           String        @id @default(cuid())
  code         String?       @unique
  name         String
  description  String?
  status       ProjectStatus @default(ACTIVE)
  startDate    DateTime?
  endDate      DateTime?
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
}

model Debt {
  id             String        @id @default(cuid())
  personName     String
  direction      DebtDirection
  amount         Decimal       @db.Decimal(14, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(14, 2)
  remainingAmount Decimal      @default(0) @db.Decimal(14, 2)
  status         DebtStatus    @default(OPEN)
  notes          String?
  transactions   Transaction[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([personName])
  @@index([direction, status])
}

model Transaction {
  id                String            @id @default(cuid())
  type              TransactionType
  status            TransactionStatus @default(COMPLETED)
  cashFlowDirection CashFlowDirection @default(NEUTRAL)
  categoryId        String
  category          Category          @relation(fields: [categoryId], references: [id])
  amount            Decimal           @db.Decimal(14, 2)
  description       String
  projectId         String?
  project           Project?          @relation(fields: [projectId], references: [id])
  employeeId        String?
  employee          Employee?         @relation(fields: [employeeId], references: [id])
  debtId            String?
  debt              Debt?             @relation(fields: [debtId], references: [id])
  transactionDate   DateTime
  paymentMethod     PaymentMethod     @default(OTHER)
  referenceNumber   String?
  attachmentUrl     String?
  notes             String?
  source            TransactionSource @default(MANUAL)
  isSystemGenerated Boolean           @default(false)
  createdById       String?
  createdBy         Profile?          @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  updatedById       String?
  updatedBy         Profile?          @relation("TransactionUpdatedBy", fields: [updatedById], references: [id])
  isDeleted         Boolean           @default(false)
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([type, transactionDate])
  @@index([status])
  @@index([categoryId])
  @@index([projectId])
  @@index([employeeId])
  @@index([debtId])
  @@index([isDeleted])
  @@index([source])
}

enum DocType {
  QUOTATION
  PROFORMA
  TAX_INVOICE
  NON_GST_INVOICE
  LETTERHEAD
  CERTIFICATE
}

enum DocStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model Document {
  id                   String         @id @default(cuid())
  docType              DocType        @default(TAX_INVOICE)
  isGstBill            Boolean        @default(true)
  docSubtitle          String?
  docNumber            String         @unique
  date                 DateTime       @default(now())
  dueDate              DateTime?
  refNo                String?
  piReference          String?
  placeOfSupply        String?        @default("Kerala (State Code: 32)")
  leadId               String?
  leadNumber           String?
  
  // Client / Recipient Info
  recipientName        String?
  recipientOrg         String
  recipientAddress     String
  recipientGstin       String?
  
  // Content
  subject              String?
  bodyText             String?
  
  // Tax Details
  gstMode              String         @default("calculated")
  gstType              String         @default("intrastate")
  taxRate              Decimal        @default(18) @db.Decimal(5, 2)
  subtotal             Decimal        @db.Decimal(14, 2)
  discountTotal        Decimal        @default(0) @db.Decimal(14, 2)
  taxAmount            Decimal        @default(0) @db.Decimal(14, 2)
  cgstAmount           Decimal        @default(0) @db.Decimal(14, 2)
  sgstAmount           Decimal        @default(0) @db.Decimal(14, 2)
  igstAmount           Decimal        @default(0) @db.Decimal(14, 2)
  grandTotal           Decimal        @db.Decimal(14, 2)
  amountInWords        String?
  
  // Table Schema & Column Customization
  tableMode            String?        @default("tax_invoice")
  qtyColumnLabel       String?
  colHeaderItem        String?
  colHeaderSac         String?
  colHeaderQty         String?
  colHeaderRate        String?
  colHeaderAmount      String?
  showSacCode          Boolean        @default(true)
  showQtyColumn        Boolean        @default(true)
  showRateColumn       Boolean        @default(true)
  showRowAmounts       Boolean        @default(true)

  // Total & Tax Display Modes
  totalDisplayMode     String?        @default("full_breakdown")
  showGstDetails       String?        @default("show")
  customSubtotal       Decimal?       @db.Decimal(14, 2)
  advancePercent       Decimal?       @db.Decimal(5, 2)
  totalContractValue   Decimal?       @db.Decimal(14, 2)

  // Payment Breakdown & Notes
  advanceReceived      Decimal        @default(0) @db.Decimal(14, 2)
  balanceDue           Decimal        @default(0) @db.Decimal(14, 2)
  paymentTerms         String?
  validityNotes        String?
  closingText          String?
  signatoryName        String         @default("Mithlaj MT.")
  signatoryTitle       String         @default("Co-Founder & CTO")
  bankAccountId        String?        @default("bank_federal_nihal")
  bankAccountNote      String?
  
  // Display Toggles
  showSeal             Boolean        @default(true)
  showSignature        Boolean        @default(true)
  showWatermark        Boolean        @default(true)
  showRecipientSection Boolean        @default(true)
  showCompanyGst       Boolean        @default(true)
  showBankDetails      Boolean        @default(true)
  showBankTransferNote Boolean        @default(true)
  showTerms            Boolean        @default(true)
  showValidity         Boolean        @default(true)
  showFooter           Boolean        @default(true)

  // Arbitrary Extensible Metadata
  metadata             Json?
  
  // Items relation
  items                DocumentItem[]
  
  status               DocStatus      @default(ISSUED)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([docType])
  @@index([docNumber])
  @@index([isGstBill])
  @@index([status])
}

model DocumentItem {
  id              String   @id @default(cuid())
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  description     String
  sacCode         String?
  qty             Decimal  @default(1) @db.Decimal(10, 2)
  unit            String?  @default("Days")
  price           Decimal  @db.Decimal(14, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  amount          Decimal  @db.Decimal(14, 2)

  @@index([documentId])
}
